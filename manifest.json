{
  "manifest_version": 3,
  "name": "Bookmark Toggle",
  "version": "1.0.0",
  "description": "ショートカット1つで、表示中のページのブックマークを追加・削除する",
  "permissions": ["bookmarks", "activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ブックマークを追加・削除（⌥⇧B）",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-bookmark": {
      "suggested_key": {
        "default": "Alt+Shift+B"
      },
      "description": "表示中のページのブックマークを追加・削除する"
    }
  }
}

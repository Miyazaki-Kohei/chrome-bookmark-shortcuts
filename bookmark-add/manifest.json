{
  "manifest_version": 3,
  "name": "ブックマーク追加",
  "version": "1.0.0",
  "description": "ショートカットでフォルダを選び、表示中のページをブックマークに追加する",
  "permissions": ["bookmarks", "activeTab", "storage"],
  "action": {
    "default_title": "ブックマークに追加（⌥⇧B）",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+B"
      },
      "description": "フォルダを選んでブックマークに追加する"
    }
  }
}
